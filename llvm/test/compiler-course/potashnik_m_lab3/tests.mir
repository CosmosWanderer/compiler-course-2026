# RUN: llc -mtriple x86_64-unknown-linux-gnu \
# RUN:     --load=%llvmshlibdir/potashnik_m_lab3_BACKEND%shlibext \
# RUN:     -run-pass=PotashnikLoopUnroll \
# RUN:     %s -o - | FileCheck %s

--- |
  target triple = "x86_64-pc-linux-gnu"

  define void @foo(i32) { ret void }
  define void @no_loop_to_unroll() { ret void }
  define void @simple_unroll() { ret void }
  define void @full_unroll_5() { ret void }
  define void @no_unroll_non_divisible() { ret void }
  define void @no_unroll_trip_exceeds_max() { ret void }
  define void @bigger_unroll_10() { ret void }
...
---
name:            foo
frameInfo:
  adjustsStack:    false
body:            |
  bb.0:
    RET 0
...

# CHECK-LABEL: name: no_loop_to_unroll
# CHECK: RET 0
---
name:            no_loop_to_unroll
frameInfo:
  adjustsStack:    false
body:            |
  bb.0:
    RET 0
...

# CHECK-LABEL: name: simple_unroll
# CHECK-COUNT-4: CALL64pcrel32 @foo
# CHECK: RET 0
---
name:            simple_unroll
frameInfo:
  adjustsStack:    true
body:            |
  bb.0:
    %0:gr32 = MOV32r0 implicit-def dead $eflags

  bb.1:   ; header/latch/exiting
    successors: %bb.2, %bb.1
    ADJCALLSTACKDOWN64 0, 0, 0, implicit-def dead $rsp, implicit-def dead $eflags, implicit-def dead $ssp, implicit $rsp, implicit $ssp
    $edi = COPY %0
    CALL64pcrel32 @foo, csr_64, implicit $rsp, implicit $ssp, implicit killed $edi, implicit-def $rsp, implicit-def $ssp
    ADJCALLSTACKUP64 0, 0, implicit-def dead $rsp, implicit-def dead $eflags, implicit-def dead $ssp, implicit $rsp, implicit $ssp
    %0:gr32 = ADD32ri8 %0, 1, implicit-def dead $eflags
    CMP32ri %0, 4, implicit-def $eflags
    JCC_1 %bb.2, 4, implicit killed $eflags
    JMP_1 %bb.1

  bb.2:
    RET 0
...

# CHECK-LABEL: name: full_unroll_5
# CHECK-COUNT-5: CALL64pcrel32 @foo
# CHECK: RET 0
---
name:            full_unroll_5
frameInfo:
  adjustsStack:    true
body:            |
  bb.0:
    %0:gr32 = MOV32r0 implicit-def dead $eflags

  bb.1:
    successors: %bb.2, %bb.1
    ADJCALLSTACKDOWN64 0, 0, 0, implicit-def dead $rsp, implicit-def dead $eflags, implicit-def dead $ssp, implicit $rsp, implicit $ssp
    $edi = COPY %0
    CALL64pcrel32 @foo, csr_64, implicit $rsp, implicit $ssp, implicit killed $edi, implicit-def $rsp, implicit-def $ssp
    ADJCALLSTACKUP64 0, 0, implicit-def dead $rsp, implicit-def dead $eflags, implicit-def dead $ssp, implicit $rsp, implicit $ssp
    %0:gr32 = ADD32ri8 %0, 1, implicit-def dead $eflags
    CMP32ri %0, 5, implicit-def $eflags
    JCC_1 %bb.2, 4, implicit killed $eflags
    JMP_1 %bb.1

  bb.2:
    RET 0
...

# CHECK-LABEL: name: no_unroll_non_divisible
# CHECK:      CALL64pcrel32 @foo
# CHECK-NOT:  CALL64pcrel32 @foo
# CHECK:      JMP_1
---
name:            no_unroll_non_divisible
frameInfo:
  adjustsStack:    true
body:            |
  bb.0:
    %0:gr32 = MOV32r0 implicit-def dead $eflags

  bb.1:
    successors: %bb.2, %bb.1
    ADJCALLSTACKDOWN64 0, 0, 0, implicit-def dead $rsp, implicit-def dead $eflags, implicit-def dead $ssp, implicit $rsp, implicit $ssp
    $edi = COPY %0
    CALL64pcrel32 @foo, csr_64, implicit $rsp, implicit $ssp, implicit killed $edi, implicit-def $rsp, implicit-def $ssp
    ADJCALLSTACKUP64 0, 0, implicit-def dead $rsp, implicit-def dead $eflags, implicit-def dead $ssp, implicit $rsp, implicit $ssp
    %0:gr32 = ADD32ri8 %0, 1, implicit-def dead $eflags
    CMP32ri %0, 7, implicit-def $eflags
    JCC_1 %bb.2, 4, implicit killed $eflags
    JMP_1 %bb.1

  bb.2:
    RET 0
...

# CHECK-LABEL: name: no_unroll_trip_exceeds_max
# CHECK:      CALL64pcrel32 @foo
# CHECK-NOT:  CALL64pcrel32 @foo
# CHECK:      JMP_1
---
name:            no_unroll_trip_exceeds_max
frameInfo:
  adjustsStack:    true
body:            |
  bb.0:
    %0:gr32 = MOV32r0 implicit-def dead $eflags

  bb.1:
    successors: %bb.2, %bb.1
    ADJCALLSTACKDOWN64 0, 0, 0, implicit-def dead $rsp, implicit-def dead $eflags, implicit-def dead $ssp, implicit $rsp, implicit $ssp
    $edi = COPY %0
    CALL64pcrel32 @foo, csr_64, implicit $rsp, implicit $ssp, implicit killed $edi, implicit-def $rsp, implicit-def $ssp
    ADJCALLSTACKUP64 0, 0, implicit-def dead $rsp, implicit-def dead $eflags, implicit-def dead $ssp, implicit $rsp, implicit $ssp
    %0:gr32 = ADD32ri8 %0, 1, implicit-def dead $eflags
    CMP32ri %0, 1025, implicit-def $eflags
    JCC_1 %bb.2, 4, implicit killed $eflags
    JMP_1 %bb.1

  bb.2:
    RET 0
...

# CHECK-LABEL: name: bigger_unroll_10
# CHECK-COUNT-5: CALL64pcrel32 @foo
# CHECK: RET 0
---
name:            bigger_unroll_10
frameInfo:
  adjustsStack:    true
body:            |
  bb.0:
    %0:gr32 = MOV32r0 implicit-def dead $eflags

  bb.1:   ; header/latch/exiting
    successors: %bb.2, %bb.1
    ADJCALLSTACKDOWN64 0, 0, 0, implicit-def dead $rsp, implicit-def dead $eflags, implicit-def dead $ssp, implicit $rsp, implicit $ssp
    $edi = COPY %0
    CALL64pcrel32 @foo, csr_64, implicit $rsp, implicit $ssp, implicit killed $edi, implicit-def $rsp, implicit-def $ssp
    ADJCALLSTACKUP64 0, 0, implicit-def dead $rsp, implicit-def dead $eflags, implicit-def dead $ssp, implicit $rsp, implicit $ssp
    %0:gr32 = ADD32ri8 %0, 1, implicit-def dead $eflags
    CMP32ri %0, 10, implicit-def $eflags
    JCC_1 %bb.2, 4, implicit killed $eflags
    JMP_1 %bb.1

  bb.2:
    RET 0
...
